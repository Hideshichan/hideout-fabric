{
	"schemaVersion": 1,
	"id": "hideout",
	"version": "${version}",
	"name": "hideout",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/hideout/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "name.modid.Hideout",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "name.modid.client.HideoutClient",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"hideout.mixins.json",
		{
			"config": "hideout.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*",
		"fabric-language-kotlin": "*",
		"hypixel-mod-api": ">=1.0.1",
		"yet_another_config_lib_v3": ">=3.8.2"
	}
}